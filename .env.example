OPENAI_API_KEY=
SCRAPER_MAX_DEPTH=2
SCRAPER_MAX_PAGES=100
SCRAPER_SAME_DOMAIN_ONLY=true
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_CONCURRENCY=3
SCRAPER_REQUEST_DELAY_S=1.0
SCRAPER_NAV_TIMEOUT_MS=30000
SCRAPER_LLM_MODEL=openai:gpt-5
SCRAPER_OUTPUT_DIR=./output
SCRAPER_LOG_LEVEL=INFO
SCRAPER_LOG_FORMAT=json
